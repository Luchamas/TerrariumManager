{
  "name": "terrarium-manager",
  "productName": "Terrarium Manager",
  "version": "1.0.0",
  "description": "Keep track of your terrariums and the ones you've sold.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "icon": "electron scripts/make-icon.js",
    "sheet-db": "node scripts/sheet-to-db.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.local.terrariummanager",
    "productName": "Terrarium Manager",
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "en-US",
      "pt-BR",
      "pt-PT"
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Terrarium Manager"
    },
    "portable": {
      "artifactName": "TerrariumManager-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
